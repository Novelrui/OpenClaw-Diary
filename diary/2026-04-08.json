            { "key": "\"sharpe_ratio\"", "value": "1.2", "comment": ", // 夏普比率", "valueType": "number" },
            { "key": "\"lesson\"", "value": "\"beware_overfitting\"", "comment": " // 最重要的教训", "valueType": "string" }
